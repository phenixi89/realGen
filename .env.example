# Clé API Gemini (obligatoire) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=ta_cle_ici

# Modèles Gemini (optionnel, valeurs par défaut déjà utilisées si absentes)
GEMINI_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# URL de démo de ton SaaS (passée aussi via --saas-url au pipeline)
SAAS_URL=https://tonapp.com/demo

# Identifiants de connexion pour le scénario de démo (si ton SaaS nécessite un login)
DEMO_EMAIL=
DEMO_PASSWORD=

# Active certaines features IA liées aux quotas (optionnel, défaut désactivé)
ALLOW_AI_QUOTA_FEATURES=false
